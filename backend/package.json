{
  "name": "streamz-backend",
  "version": "1.0.0",
  "description": "Streamz pay-per-view video streaming backend",
  "private": true,
  "workspaces": [
    "shared",
    "services/*",
    "api-gateway"
  ],
  "main": "dist/index.js",
  "scripts": {
    "dev": "concurrently -k -n auth,video,purchase,streaming,webhook,gateway -c blue,green,yellow,magenta,cyan,red \"npm run dev -w services/auth\" \"npm run dev -w services/video\" \"npm run dev -w services/purchase\" \"npm run dev -w services/streaming\" \"npm run dev -w services/webhook\" \"npm run dev -w api-gateway\"",
    "dev:gateway": "npm run dev -w @streamz/api-gateway",
    "build": "tsc -p services/auth && tsc -p services/purchase && tsc -p services/webhook && tsc -p services/streaming && tsc -p services/video && tsc -p api-gateway",
    "start": "npm run start -w @streamz/api-gateway",
    "migrate": "ts-node migrations/run.ts",
    "mock:webhook": "node scripts/mock-webhooks.mjs",
    "lint": "eslint services/**/*.ts api-gateway/**/*.ts"
  },
  "dependencies": {
    "@mux/mux-node": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0",
    "stripe": "^17.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.10",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.0"
  }
}
