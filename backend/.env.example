PORT=3000
NODE_ENV=development

# PostgreSQL
# Never hardcode a database password in committed files. Generate a strong one and
# put it in your local (git-ignored) backend/.env first:
#   Linux/macOS:  openssl rand -hex 32
#   PowerShell:   -join ((97..122)+(65..90)+(48..57) | Get-Random -Count 24 | ForEach-Object {[char]$_})
# POSTGRES_PASSWORD is read by docker-compose and used to build DATABASE_URL.
#   Direct connection (local dev):  postgresql://streamz:<POSTGRES_PASSWORD>@localhost:5432/streamz
#   Pooled connection (docker, via PgBouncer): postgresql://streamz:<POSTGRES_PASSWORD>@localhost:6432/streamz
POSTGRES_PASSWORD=change-me-generate-a-strong-one
DATABASE_URL=postgresql://streamz:change-me-generate-a-strong-one@localhost:5432/streamz

# JWT
JWT_SECRET=your-jwt-secret
JWT_REFRESH_SECRET=your-jwt-refresh-secret
JWT_EXPIRES_IN=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CURRENCY=usd
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Mux
MUX_TOKEN_ID=your-mux-token-id
MUX_TOKEN_SECRET=your-mux-token-secret
MUX_WEBHOOK_SECRET=your-mux-webhook-signing-secret
# Signed playback (optional). When both are set, uploads use signed
# playback policy and playback/thumbnail URLs carry a rental-aligned JWT.
MUX_SIGNING_KEY=your-mux-signing-key-id
MUX_PRIVATE_KEY=your-mux-signing-private-key-pem
# Signed playback URL lifetime in seconds (bounded by remaining rental time).
PLAYBACK_TTL_SECONDS=3600

# Gateway CORS - set to your app origins in production, e.g. https://app.example.com
CORS_ORIGIN=*

# Frontend URLs (for CORS + redirects)
IOS_URL=streamz://
ANDROID_URL=streamz://

# Observability
# Set to http://localhost:4318 (or http://otel-collector:4318 in docker) to enable OTLP tracing.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Structured JSON logs instead of pretty-printed (1 = on).
LOG_JSON=0
# Grafana admin password (used by docker-compose).
GRAFANA_ADMIN_PASSWORD=admin