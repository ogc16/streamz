PORT=3000
NODE_ENV=development

# PostgreSQL
# Direct connection (local dev):  postgresql://streamz:streamz_secret@localhost:5432/streamz
# Pooled connection (docker, via PgBouncer): postgresql://streamz:streamz_secret@localhost:6432/streamz
DATABASE_URL=postgresql://streamz:streamz_secret@localhost:5432/streamz

# JWT
JWT_SECRET=your-jwt-secret
JWT_REFRESH_SECRET=your-jwt-refresh-secret
JWT_EXPIRES_IN=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CURRENCY=usd
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Mux
MUX_TOKEN_ID=your-mux-token-id
MUX_TOKEN_SECRET=your-mux-token-secret
MUX_WEBHOOK_SECRET=your-mux-webhook-signing-secret
# Signed playback (optional). When both are set, uploads use signed
# playback policy and playback/thumbnail URLs carry a rental-aligned JWT.
MUX_SIGNING_KEY=your-mux-signing-key-id
MUX_PRIVATE_KEY=your-mux-signing-private-key-pem
# Signed playback URL lifetime in seconds (bounded by remaining rental time).
PLAYBACK_TTL_SECONDS=3600

# Gateway CORS - set to your app origins in production, e.g. https://app.example.com
CORS_ORIGIN=*

# Frontend URLs (for CORS + redirects)
IOS_URL=streamz://
ANDROID_URL=streamz://

# Observability
# Set to http://localhost:4318 (or http://otel-collector:4318 in docker) to enable OTLP tracing.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Structured JSON logs instead of pretty-printed (1 = on).
LOG_JSON=0
# Grafana admin password (used by docker-compose).
GRAFANA_ADMIN_PASSWORD=admin